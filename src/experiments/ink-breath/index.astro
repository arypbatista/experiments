---

<canvas id="c" style="position:fixed;inset:0;display:block;width:100%;height:100%;"></canvas>

<script>
  import * as THREE from 'three';
  import { INK_URL } from '../../lib/ink';

  const fragmentShader = /* glsl */ `
    uniform sampler2D uTex;
    uniform float uTime;
    uniform vec2 uRes;
    uniform vec2 uImg;
    varying vec2 vUv;

    const vec3 PAPER = vec3(0.925, 0.922, 0.902);
    const vec3 INK = vec3(0.078, 0.075, 0.07);

    float density(vec2 uv) { return 1.0 - textureLod(uTex, uv, 4.5).r; }

    void main() {
      // fit the drawing to 86% of the screen
      vec2 p = (vUv - 0.5) * uRes;
      float s = min(uRes.x * 0.86 / uImg.x, uRes.y * 0.86 / uImg.y);
      vec2 uv = p / (uImg * s) + 0.5;

      // whole mass inhales/exhales around its center
      float breath = sin(uTime * 0.8);
      uv = (uv - 0.5) * (1.0 - 0.012 * breath) + 0.5;

      // slow organic drift
      uv += 0.0025 * vec2(sin(uv.y * 9.0 + uTime * 0.5), cos(uv.x * 7.0 + uTime * 0.4));

      // dense regions swell: sample toward higher density (gradient direction),
      // with a phase that varies across the figure so it pulses like organs
      vec2 e = vec2(6.0 / uImg.x, 6.0 / uImg.y);
      vec2 grad = vec2(density(uv + vec2(e.x, 0.0)) - density(uv - vec2(e.x, 0.0)),
                       density(uv + vec2(0.0, e.y)) - density(uv - vec2(0.0, e.y)));
      float pulse = sin(uTime * 1.3 - uv.y * 6.0 + density(uv) * 4.0);
      uv += grad * 0.05 * pulse;

      float ink = 1.0 - texture(uTex, uv).r;
      if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) ink = 0.0;
      gl_FragColor = vec4(mix(PAPER, INK, ink), 1.0);
    }
  `;

  const vertexShader = /* glsl */ `
    varying vec2 vUv;
    void main() { vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }
  `;

  const canvas = document.getElementById('c') as HTMLCanvasElement;
  const renderer = new THREE.WebGLRenderer({ canvas });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight, false);
  renderer.outputColorSpace = THREE.LinearSRGBColorSpace;

  const scene = new THREE.Scene();
  const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

  const uniforms = {
    uTex: { value: null as THREE.Texture | null },
    uTime: { value: 0 },
    uRes: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
    uImg: { value: new THREE.Vector2(1, 1) },
  };
  scene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), new THREE.ShaderMaterial({ uniforms, vertexShader, fragmentShader })));

  new THREE.TextureLoader().load(INK_URL, (tex) => {
    tex.minFilter = THREE.LinearMipmapLinearFilter;
    tex.wrapS = tex.wrapT = THREE.ClampToEdgeWrapping;
    uniforms.uTex.value = tex;
    uniforms.uImg.value.set(tex.image.width, tex.image.height);
    const clock = new THREE.Clock();
    renderer.setAnimationLoop(() => {
      uniforms.uTime.value = clock.getElapsedTime();
      renderer.render(scene, camera);
    });
  });

  window.addEventListener('resize', () => {
    renderer.setSize(window.innerWidth, window.innerHeight, false);
    uniforms.uRes.value.set(window.innerWidth, window.innerHeight);
  });
</script>
